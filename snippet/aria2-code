ARIA2_VERSION="1.37.0"
ARIA2_TAG="release-${ARIA2_VERSION}"
#

ARIA2_GIT_CODE() {
    if [[ -d $ARIA2_CODE_DIR && -d $ARIA2_CODE_DIR/.git ]]; then
        cd $ARIA2_CODE_DIR
    else
        rm -rf $ARIA2_CODE_DIR
        git clone --depth 1 --branch "$ARIA2_TAG" https://github.com/aria2/aria2 $ARIA2_CODE_DIR
        cd $ARIA2_CODE_DIR
    fi
    git fetch --force origin "refs/tags/$ARIA2_TAG:refs/tags/$ARIA2_TAG"
    git checkout --detach "$ARIA2_TAG"
    git reset --hard "$ARIA2_TAG"
    autoreconf -fi || autoreconf -fiv
}

ARIA2_RELEASE_CODE() {
    mkdir -p $ARIA2_CODE_DIR && cd $ARIA2_CODE_DIR
    curl -Ls "https://github.com/aria2/aria2/releases/download/${ARIA2_TAG}/aria2-${ARIA2_VERSION}.tar.xz" |
        tar Jxvf - --strip-components=1
}

ARIA2_PATCH() {
    if [ "${SKIP_PATCHES:-0}" = 1 ]; then
        return
    fi
    git apply $SCRIPT_DIR/patch/0001-options-unlock-connection-per-server-limit.patch
    git apply $SCRIPT_DIR/patch/0002-download-retry-on-slow-speed-and-reset.patch
    git apply $SCRIPT_DIR/patch/0003-option-add-option-to-retry-on-http-4xx.patch
    git apply $SCRIPT_DIR/patch/0004-option-set-no-want-digest-header-default-to-true.patch
}

ARIA2_CODE_GET() {
    ARIA2_GIT_CODE
    ARIA2_PATCH
}
