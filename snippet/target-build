# Modify: Use all logical CPUs by default; MAX_JOBS can limit parallelism.
#

CPU_CORES=$(command -v nproc >/dev/null 2>&1 && nproc || sysctl -n hw.logicalcpu)
JOBS=${MAX_JOBS:-$CPU_CORES}
if ! [[ "$JOBS" =~ ^[1-9][0-9]*$ ]]; then
    JOBS=$CPU_CORES
fi

# Download archives reliably in CI.  With `set -o pipefail`, curl failures
# must be reported before tar attempts to unpack an error page.
DOWNLOAD() {
    local url="$1" output="$2"
    curl --fail --location --silent --show-error --retry 5 --retry-all-errors \
        --connect-timeout 20 --max-time 300 -o "$output" "$url"
}
if (( JOBS > CPU_CORES )); then
    JOBS=$CPU_CORES
fi

ZLIB_BUILD() {
    mkdir -p $BUILD_DIR/zlib && cd $BUILD_DIR/zlib
    DOWNLOAD "$ZLIB" /tmp/zlib.tar.gz
    tar zxf /tmp/zlib.tar.gz --strip-components=1
    ./configure \
        --prefix=$PREFIX \
        --static
    make -j${JOBS}
    make install
}

EXPAT_BUILD() {
    mkdir -p $BUILD_DIR/expat && cd $BUILD_DIR/expat
    DOWNLOAD "$EXPAT" /tmp/expat.tar.xz
    tar Jxf /tmp/expat.tar.xz --strip-components=1
    ./configure \
        --prefix=$PREFIX \
        --enable-static \
        --disable-shared \
        --without-examples \
        --without-tests \
        --without-docbook
    make -j${JOBS}
    make install
}

C_ARES_BUILD() {
    mkdir -p $BUILD_DIR/c-ares && cd $BUILD_DIR/c-ares
    DOWNLOAD "$C_ARES" /tmp/c-ares.tar.gz
    tar zxf /tmp/c-ares.tar.gz --strip-components=1
    ./configure \
        --prefix=$PREFIX \
        --enable-static \
        --disable-shared \
        --disable-tests
    make -j${JOBS}
    make install
}

OPENSSL_BUILD() {
    mkdir -p $BUILD_DIR/openssl && cd $BUILD_DIR/openssl
    DOWNLOAD "$OPENSSL" /tmp/openssl.tar.gz
    tar zxf /tmp/openssl.tar.gz --strip-components=1
    local extra_options=()
    if [ "$(uname -s)" = Darwin ]; then
        extra_options+=(no-shared)
    fi
    ./Configure \
        --prefix=$PREFIX \
        $OPENSSL_ARCH \
        no-tests "${extra_options[@]}"
    make -j${JOBS}
    make install_sw
}

SQLITE3_BUILD() {
    mkdir -p $BUILD_DIR/sqlite3 && cd $BUILD_DIR/sqlite3
    DOWNLOAD "$SQLITE3" /tmp/sqlite3.tar.gz
    tar zxf /tmp/sqlite3.tar.gz --strip-components=1
    ./configure \
        --prefix=$PREFIX \
        --enable-static \
        --disable-shared \
        --disable-dynamic-extensions
    make -j${JOBS}
    make install
}

LIBSSH2_BUILD() {
    mkdir -p $BUILD_DIR/libssh2 && cd $BUILD_DIR/libssh2
    DOWNLOAD "$LIBSSH2" /tmp/libssh2.tar.gz
    tar zxf /tmp/libssh2.tar.gz --strip-components=1
    ./configure \
        --prefix=$PREFIX \
        --enable-static \
        --disable-shared \
