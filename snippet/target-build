JEMALLOC_BUILD() {
    if [ "$(uname -s)" = Darwin ]; then
        return
    fi
    mkdir -p $BUILD_DIR/jemalloc && cd $BUILD_DIR/jemalloc
    DOWNLOAD "$JEMALLOC" /tmp/jemalloc.tar.bz2
    tar jxf /tmp/jemalloc.tar.bz2 --strip-components=1
    ./configure \
        --prefix=$PREFIX \
        --enable-static \
        --disable-shared \
        --disable-stats \
        --enable-prof
    make -j${JOBS}
    make install
}

ARIA2_BUILD() {
    ARIA2_CODE_GET
    local jemalloc_option=--with-jemalloc
    local nls_option=--enable-nls
    if [ "$(uname -s)" = Darwin ]; then
        jemalloc_option=--without-jemalloc
        nls_option=--disable-nls
    fi
    ./configure \
        --prefix=${ARIA2_PREFIX:-'/usr/local'} \
        --with-libz \
        --with-libcares \
        --with-libexpat \
        --without-libxml2 \
        --without-libgcrypt \
        --with-openssl \
        --without-libnettle \
        --without-gnutls \
        --without-libgmp \
        --with-libssh2 \
        --with-sqlite3 \
        "$jemalloc_option" \
        "$nls_option" \
        --with-ca-bundle="${CA_BUNDLE:-/etc/ssl/certs/ca-certificates.crt}" \
        ARIA2_STATIC=yes \
        --disable-shared
    make -j${JOBS}
}
